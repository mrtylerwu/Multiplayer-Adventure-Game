solid = true;               // the base footprint blocks the player
fade_alpha = 1;
can_fade = true;
near_me = false;
hover_me = false;
interact_range = 160;       // how close you must be to use it, in pixels
interact_text = "";         // a hint shown when you can use it
map_visible = true;         // shown on the minimap?
map_color = c_white;        // its marker color on the minimap
depth = -y;                 // lower on screen = drawn in front